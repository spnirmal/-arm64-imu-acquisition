 	result = regmap_write(st->map, st->reg->pwr_mgmt_1,
 			      INV_MPU6050_BIT_H_RESET);
@@ -1790,6 +1767,41 @@
 	result = inv_mpu6050_set_power_itg(st, true);
 	if (result)
 		return result;
+
+	/* check chip self-identification */
+	result = regmap_read(st->map, INV_MPU6050_REG_WHOAMI, &regval);
+	if (result)
+		return result;
+
+	/* Auto-adapt if device self-identifies as MPU6500 (0x70) */
+	if (regval == 0x70 && st->chip_type == INV_MPU9250) {
+		dev_info(regmap_get_device(st->map),
+			 "Device self-identified as MPU6500 (0x70), adapting from MPU9250\n");
+		st->chip_type = INV_MPU6500;
+		st->hw = &hw_info[INV_MPU6500];
+		st->reg = hw_info[INV_MPU6500].reg;
+		memcpy(&st->chip_config, hw_info[INV_MPU6500].config,
+		       sizeof(st->chip_config));
+	}
+
+	if (regval != st->hw->whoami) {
+		/* check whoami against all possible values */
+		for (i = 0; i < INV_NUM_PARTS; ++i) {
+			if (regval == hw_info[i].whoami) {
+				dev_warn(regmap_get_device(st->map),
+					"whoami mismatch got 0x%02x (%s) expected 0x%02x (%s)\n",
+					regval, hw_info[i].name,
+					st->hw->whoami, st->hw->name);
+				break;
+			}
+		}
+		if (i >= INV_NUM_PARTS) {
+			dev_err(regmap_get_device(st->map),
+				"invalid whoami 0x%02x expected 0x%02x (%s)\n",
+				regval, st->hw->whoami, st->hw->name);
+			return -ENODEV;
+		}
+	}
 	mask = INV_MPU6050_SENSOR_ACCL | INV_MPU6050_SENSOR_GYRO |
 			INV_MPU6050_SENSOR_TEMP | INV_MPU6050_SENSOR_MAGN;
 	result = inv_mpu6050_switch_engine(st, false, mask);
